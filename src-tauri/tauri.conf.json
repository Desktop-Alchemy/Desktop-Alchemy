{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Alchemy",
  "version": "0.1.0",
  "identifier": "dev.masterain.desktopalchemy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop Alchemy",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' blob: ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../licenses/": "licenses/",
      "../vendor/device-sdk/native/*.dll": "sdk/native/",
      "../vendor/device-sdk/native/SOURCES.json": "sdk/native/SOURCES.json",
      "../licenses/device-sdk-MIT.txt": "sdk/LICENSE",
      "../licenses/device-sdk-CPP-SDK-MIT-and-notice.txt": "sdk/LICENSE-CPP-SDK",
      "../plugins/performance/plugin.json": "plugins/performance/plugin.json",
      "../plugins/performance/m18-performance-plugin.exe": "plugins/performance/m18-performance-plugin.exe",
      "../plugins/performance/sensors/publish/": "plugins/performance/sensors/publish/",
      "../examples/counter.m18plugin": "examples/counter.m18plugin",
      "resources/icon-library/README.md": "icon-library/README.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
