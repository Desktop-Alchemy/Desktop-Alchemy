{
  "name": "desktop-alchemy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "model:m18": "node scripts/build-m18-model.mjs",
    "model:m18:preview": "node scripts/export-m18-preview.mjs",
    "plugins:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-plugins.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1",
    "test:mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Suite Mcp",
    "test:plugins": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Suite Plugins",
    "test:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Suite Launch",
    "test:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Suite Full",
    "bindings": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Suite Bindings",
    "sdk:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-sdk.ps1",
    "plugin:pack": "cargo run --manifest-path src-tauri/Cargo.toml --bin m18-plugin-pack --features diagnostics --locked --",
    "plugin:pack:icon-example": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-icon-example.ps1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@phosphor-icons/vue": "2.2.1",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "pinia": "^3.0.3",
    "three": "0.187.0",
    "vue": "^3.5.22",
    "vue-i18n": "11.4.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "pnpm@11.18.0"
}
